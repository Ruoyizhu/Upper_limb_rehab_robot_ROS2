<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeset="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rehab_robot_description</name>
  <version>0.0.0</version>
  <description>Robot description for rehabilitation robot</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- URDF相关依赖 -->
  <depend>urdf</depend>
  <depend>xacro</depend>
  
  <!-- Gazebo相关依赖 -->
  <depend>gazebo_ros</depend>
  <depend>gazebo_plugins</depend>
  
  <!-- ROS 2控制相关依赖 -->
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  
  <!-- 其他必要依赖 -->
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>