<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <!-- 全局光源 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面平面（关键：确保地面存在） -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 物理引擎配置 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

  </world>
</sdf>